# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL database URL (sqlx).
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=

# Browser origin allowed for CORS (e.g. your frontend dev server or production URL).
# Example: http://localhost:5173
FRONTEND_URL=

# Judge0 API base URL for code execution (Phase 6).
# Example: http://localhost:2358
JUDGE0_URL=

# ── Optional (defaults shown) ────────────────────────────────────────────────

# Bind address for the HTTP server. Default: 0.0.0.0
HOST=0.0.0.0

# TCP port for the HTTP server. Default: 8080
PORT=8080

# Requests per second sustained (tower_governor). Default: 10
RATE_LIMIT_PER_SECOND=10

# Burst allowance for rate limiting. Default: 30
RATE_LIMIT_BURST_SIZE=30
